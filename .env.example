# Committed example of every environment key this project reads.
# `headspec-env-coverage` fails the commit when a literal os.getenv("X") / os.environ["X"]
# under src_roots names a key absent here and absent from [headspec] env_internal_vars.
# Values are placeholders — the real ones live in .gitignored .env, never in git.

# Base dir for proc state (jobs/registry/locks); read by core._default_base(). Default: ~/.local/state/proc
PROC_HOME=

# Staleness threshold in seconds for heavy-job locks; read by heavy_job_lock.py. Default: 14400
HEAVY_JOB_STALE_SEC=

# User systemd runtime directory. When unset, use /run/user/<uid> if it exists.
XDG_RUNTIME_DIR=

# User bus address. When unset and the runtime directory exists, use unix:path=<directory>/bus.
DBUS_SESSION_BUS_ADDRESS=

# Shared Claude settings source and managed config dirs, matching seat_settings_sync.py.
# Defaults: ~/.claude/settings.shared.json and ~/.claude (colon-separated list of config dirs)
SEAT_SETTINGS_SOURCE=
SEAT_SETTINGS_SEATS=

# Set by systemd for a unit's processes; when present, a job the launcher starts gets its own systemd scope.
INVOCATION_ID=

# Config home; the cost-alert command is read from <dir>/proc/cost_alert_cmd. Default: ~/.config
XDG_CONFIG_HOME=

# Command run (once per key per day) when a launch-due pass exceeds its cost bound; read by cost.py.
# Default: the first line of cost_alert_cmd under the config home; none means no alert.
# Read only for the default registry; any other PROC_HOME reads <home>/cost_alert_cmd.
PROC_COST_ALERT_CMD=
